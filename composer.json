{
  "name": "digital-nature/licence-verifier",
  "description": "PHP client for the Digital Nature licence verification API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=7.4",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.0",
    "psr/http-factory": "^1.0"
  },
  "suggest": {
    "guzzlehttp/guzzle": "PSR-18 HTTP client (^7.0)",
    "nyholm/psr7": "Lightweight PSR-17 request/stream factory (^1.0)",
    "symfony/http-client": "Alternative PSR-18 HTTP client (^5.0|^6.0|^7.0)"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "nyholm/psr7": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "DigitalNature\\LicenceVerifier\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DigitalNature\\LicenceVerifier\\Tests\\": "tests/"
    }
  }
}
